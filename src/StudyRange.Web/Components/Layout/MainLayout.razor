@inherits LayoutComponentBase
@inject UserSessionState Session

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 app-top-row">
            @if (Session.IsAuthenticated)
            {
                <MudStack Row="true" Breakpoint="Breakpoint.Sm" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="app-topbar-stack">
                    <span>@Session.DisplayName 님 학습 공간</span>
                    <MudStack Row="true" Spacing="1" Breakpoint="Breakpoint.Sm">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Href="/app">대시보드</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Href="/workspace">워크스페이스</MudButton>
                    </MudStack>
                </MudStack>
            }
            else
            {
                <span>StudyRange AI</span>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
