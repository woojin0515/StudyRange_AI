@page "/"
@inject IStudyCoachService StudyCoachService

<PageTitle>StudyRange AI</PageTitle>

<MudStack Spacing="3" Class="home-shell">
    <MudPaper Elevation="0" Outlined="true" Class="hero-panel">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="hero-top">
            <div>
                <MudText Typo="Typo.h4">StudyRange AI</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary">
                    워크스페이스부터 문서 처리, AI 생성, 교육 메타데이터 통합까지 한 화면에서 관리합니다.
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshCurrentWorkspaceAsync">
                새로고침
            </MudButton>
        </MudStack>

        <MudGrid Class="mt-3">
            <MudItem xs="6" md="3">
                <MudPaper Outlined="true" Class="summary-card">
                    <MudText Typo="Typo.caption">워크스페이스</MudText>
                    <MudText Typo="Typo.h6">@_workspaces.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Outlined="true" Class="summary-card">
                    <MudText Typo="Typo.caption">시험 범위</MudText>
                    <MudText Typo="Typo.h6">@_examRanges.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Outlined="true" Class="summary-card">
                    <MudText Typo="Typo.caption">문서</MudText>
                    <MudText Typo="Typo.h6">@_documents.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Outlined="true" Class="summary-card">
                    <MudText Typo="Typo.caption">처리 작업</MudText>
                    <MudText Typo="Typo.h6">@_jobs.Count</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_infoMessage))
    {
        <MudAlert Severity="Severity.Info" Dense="true">@_infoMessage</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Outlined="true" Class="section-panel">
                <MudText Typo="Typo.h6">1) Workspace</MudText>
                <MudGrid Class="mt-2">
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_workspaceName"
                                      Label="Workspace 이름"
                                      HelperText="예: 중간고사, 기말고사, 6월 모의고사"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="align-end">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="CreateWorkspaceAsync"
                                   Disabled="@string.IsNullOrWhiteSpace(_workspaceName)"
                                   FullWidth="true">
                            생성
                        </MudButton>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2">Workspace 선택</MudText>
                <MudStack Spacing="1" Class="mt-2 workspace-list">
                    @if (_workspaces.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="text-secondary">아직 생성된 Workspace가 없습니다.</MudText>
                    }
                    else
                    {
                        @foreach (var workspace in _workspaces)
                        {
                            <MudPaper Outlined="true" Class="pa-3 workspace-item">
                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">@workspace.Name</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.caption">@workspace.CreatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="@(IsSelectedWorkspace(workspace.Id) ? Color.Success : Color.Primary)"
                                                   OnClick="@(() => SelectWorkspaceAsync(workspace.Id))"
                                                   FullWidth="true">
                                            @(IsSelectedWorkspace(workspace.Id) ? "선택됨" : "선택")
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudStack Spacing="2">
                <MudPaper Elevation="0" Outlined="true" Class="section-panel">
                    <MudText Typo="Typo.h6">2) 시험 범위</MudText>
                    <MudGrid Class="mt-2">
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_subject" Label="과목" Variant="Variant.Outlined" Immediate="true" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" @bind-Value="_startPage" Label="시작 페이지" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" @bind-Value="_endPage" Label="끝 페이지" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddExamRangeAsync" Disabled="@(!IsWorkspaceSelected)" FullWidth="true">
                                등록
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Elevation="0" Outlined="true" Class="section-panel">
                    <MudText Typo="Typo.h6">3) 문서 업로드</MudText>
                    <MudGrid Class="mt-2">
                        <MudItem xs="12">
                            <MudSelect T="DocumentType" @bind-Value="_selectedDocumentType" Variant="Variant.Outlined" Label="문서 종류" FullWidth="true">
                                <MudSelectItem Value="DocumentType.TextbookPdf">Textbook PDF</MudSelectItem>
                                <MudSelectItem Value="DocumentType.Worksheet">Worksheet</MudSelectItem>
                                <MudSelectItem Value="DocumentType.HandwrittenNotes">Handwritten Notes</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <InputFile OnChange="OnFileSelected" class="form-control" accept="@UploadAccept" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UploadDocumentAsync" Disabled="@(!IsWorkspaceSelected)" FullWidth="true">
                                업로드
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    @if (!string.IsNullOrWhiteSpace(_selectedFileName))
                    {
                        <MudText Typo="Typo.caption" Class="mt-2">선택 파일: @_selectedFileName</MudText>
                    }
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="0" Outlined="true" Class="section-panel">
        <MudText Typo="Typo.h6">4) AI 요약/퀴즈 생성</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_selectedExamRangeId" Variant="Variant.Outlined" Label="시험 범위 선택" FullWidth="true">
                    @foreach (var examRange in _examRanges)
                    {
                        <MudSelectItem Value="@examRange.Id.ToString()">@($"{examRange.Subject} {examRange.StartPage}~{examRange.EndPage}")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateSummaryAsync" Disabled="@(!CanGenerateContent)" FullWidth="true">
                    요약 생성
                </MudButton>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="GenerateQuizAsync" Disabled="@(!CanGenerateContent)" FullWidth="true">
                    퀴즈 생성
                </MudButton>
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrWhiteSpace(_generatedContent))
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption">Provider: @_generatedProvider / Model: @_generatedModel</MudText>
            <MudPaper Outlined="true" Class="pa-3 mt-2 generated-content">
                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@_generatedContent</MudText>
            </MudPaper>
        }
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="section-panel">
        <MudText Typo="Typo.h6">5) 교육과정/교과서 메타데이터 (NCIC + KOTRY + NEIS)</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="3">
                <MudSelect T="SchoolLevel" @bind-Value="_metadataSchoolLevel" Variant="Variant.Outlined" Label="학교급" FullWidth="true">
                    <MudSelectItem Value="SchoolLevel.Elementary">초등</MudSelectItem>
                    <MudSelectItem Value="SchoolLevel.Middle">중등</MudSelectItem>
                    <MudSelectItem Value="SchoolLevel.High">고등</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="int" @bind-Value="_metadataGrade" Variant="Variant.Outlined" Label="학년" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="int?" @bind-Value="_metadataBirthYear" Variant="Variant.Outlined" Label="출생년도(선택)" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="_metadataSchoolName" Variant="Variant.Outlined" Label="학교명(선택)" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="1">
                <MudTextField @bind-Value="_metadataSubject" Variant="Variant.Outlined" Label="과목" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="2" Class="align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CollectEducationMetadataAsync" FullWidth="true">통합 조회</MudButton>
            </MudItem>
        </MudGrid>

        @if (_sourceStatuses.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2">소스 상태</MudText>
            <MudTable Items="_sourceStatuses" Dense="true" Hover="true" Class="mt-1">
                <HeaderContent>
                    <MudTh>소스</MudTh>
                    <MudTh>성공</MudTh>
                    <MudTh>메시지</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Source</MudTd>
                    <MudTd>@(context.Success ? "Yes" : "No")</MudTd>
                    <MudTd>@context.Message</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_curriculumResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3">교육과정</MudText>
            <MudTable Items="_curriculumResults" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>개정</MudTh>
                    <MudTh>표시명</MudTh>
                    <MudTh>설명</MudTh>
                    <MudTh>출처</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RevisionCode</MudTd>
                    <MudTd>@context.DisplayName</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>@context.Source</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_textbookResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3">교과서</MudText>
            <MudTable Items="_textbookResults" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>과목</MudTh>
                    <MudTh>출판사</MudTh>
                    <MudTh>교과서명</MudTh>
                    <MudTh>개정</MudTh>
                    <MudTh>출처</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Subject</MudTd>
                    <MudTd>@context.Publisher</MudTd>
                    <MudTd>@context.Title</MudTd>
                    <MudTd>@context.CurriculumRevision</MudTd>
                    <MudTd>@context.Source</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_schoolFactResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3">학교 맥락</MudText>
            <MudTable Items="_schoolFactResults" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>키</MudTh>
                    <MudTh>값</MudTh>
                    <MudTh>출처</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Key</MudTd>
                    <MudTd>@context.Value</MudTd>
                    <MudTd>@context.Source</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="section-panel">
                <MudText Typo="Typo.h6">시험 범위 목록</MudText>
                <MudTable Items="_examRanges" Dense="true" Hover="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>과목</MudTh>
                        <MudTh>범위</MudTh>
                        <MudTh>등록일</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Subject</MudTd>
                        <MudTd>@context.StartPage ~ @context.EndPage</MudTd>
                        <MudTd>@context.CreatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="section-panel">
                <MudText Typo="Typo.h6">문서 / 처리 작업</MudText>
                <MudTable Items="_documents" Dense="true" Hover="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>파일명</MudTh>
                        <MudTh>종류</MudTh>
                        <MudTh>상태</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.OriginalFileName</MudTd>
                        <MudTd>@context.DocumentType</MudTd>
                        <MudTd>@context.ProcessingStatus</MudTd>
                    </RowTemplate>
                </MudTable>

                <MudDivider Class="my-3" />

                <MudTable Items="_jobs" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Job</MudTh>
                        <MudTh>상태</MudTh>
                        <MudTh>완료시각</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Id.ToString()[..8]</MudTd>
                        <MudTd>@context.Status</MudTd>
                        <MudTd>@(context.CompletedAtUtc?.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private readonly List<WorkspaceModel> _workspaces = [];
    private readonly List<ExamRangeModel> _examRanges = [];
    private readonly List<DocumentModel> _documents = [];
    private readonly List<ProcessingJobModel> _jobs = [];

    private string _workspaceName = string.Empty;
    private string _selectedWorkspaceId = string.Empty;
    private string _selectedExamRangeId = string.Empty;
    private string _subject = string.Empty;
    private int _startPage = 1;
    private int _endPage = 1;
    private DocumentType _selectedDocumentType = DocumentType.TextbookPdf;
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;

    private string? _infoMessage;
    private string? _errorMessage;
    private string _generatedContent = string.Empty;
    private string _generatedProvider = string.Empty;
    private string _generatedModel = string.Empty;
    private SchoolLevel _metadataSchoolLevel = SchoolLevel.Middle;
    private int _metadataGrade = 1;
    private int? _metadataBirthYear;
    private string _metadataSchoolName = string.Empty;
    private string _metadataSubject = "과학";
    private readonly List<CurriculumRevisionModel> _curriculumResults = [];
    private readonly List<TextbookCatalogModel> _textbookResults = [];
    private readonly List<SchoolContextFactModel> _schoolFactResults = [];
    private readonly List<SourceStatusModel> _sourceStatuses = [];
    private bool IsWorkspaceSelected => Guid.TryParse(_selectedWorkspaceId, out _);
    private bool CanGenerateContent => IsWorkspaceSelected && Guid.TryParse(_selectedExamRangeId, out _);
    private string UploadAccept => _selectedDocumentType switch
    {
        DocumentType.TextbookPdf => ".pdf,application/pdf",
        DocumentType.Worksheet or DocumentType.HandwrittenNotes => ".pdf,.png,.jpg,.jpeg,.webp,application/pdf,image/png,image/jpeg,image/webp",
        _ => ".pdf"
    };

    protected override async Task OnInitializedAsync()
    {
        await ReloadWorkspacesAsync();
        if (_workspaces.Count > 0)
        {
            _selectedWorkspaceId = _workspaces[0].Id.ToString();
            await LoadWorkspaceDataAsync();
        }
    }

    private async Task CreateWorkspaceAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var created = await StudyCoachService.CreateWorkspaceAsync(_workspaceName, CancellationToken.None);
            _workspaceName = string.Empty;
            _selectedWorkspaceId = created.Id.ToString();
            await ReloadWorkspacesAsync();
            await LoadWorkspaceDataAsync();
            _infoMessage = "Workspace가 생성되었습니다.";
        });
    }

    private async Task SelectWorkspaceAsync(Guid workspaceId)
    {
        _selectedWorkspaceId = workspaceId.ToString();
        _generatedContent = string.Empty;
        _generatedProvider = string.Empty;
        _generatedModel = string.Empty;
        await LoadWorkspaceDataAsync();
    }

    private bool IsSelectedWorkspace(Guid workspaceId)
    {
        return Guid.TryParse(_selectedWorkspaceId, out var selectedId) && selectedId == workspaceId;
    }

    private async Task AddExamRangeAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var workspaceId = RequireWorkspaceSelection();
            await StudyCoachService.AddExamRangeAsync(
                workspaceId,
                _subject,
                _startPage,
                _endPage,
                CancellationToken.None);

            _subject = string.Empty;
            await LoadWorkspaceDataAsync();
            _infoMessage = "시험 범위가 등록되었습니다.";
        });
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _selectedFileName = args.File.Name;
    }

    private async Task UploadDocumentAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var workspaceId = RequireWorkspaceSelection();

            if (_selectedFile is null)
            {
                throw new InvalidOperationException("업로드할 파일을 선택하세요.");
            }

            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            await StudyCoachService.UploadDocumentAsync(
                workspaceId,
                _selectedDocumentType,
                _selectedFile.Name,
                _selectedFile.ContentType,
                _selectedFile.Size,
                stream,
                CancellationToken.None);

            _selectedFile = null;
            _selectedFileName = null;
            await LoadWorkspaceDataAsync();
            _infoMessage = "문서 업로드 후 처리 큐에 등록되었습니다.";
        });
    }

    private async Task GenerateSummaryAsync()
    {
        await GenerateContentAsync(GeneratedContentType.Summary);
    }

    private async Task GenerateQuizAsync()
    {
        await GenerateContentAsync(GeneratedContentType.Quiz);
    }

    private async Task GenerateContentAsync(GeneratedContentType contentType)
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var workspaceId = RequireWorkspaceSelection();
            if (!Guid.TryParse(_selectedExamRangeId, out var examRangeId))
            {
                throw new InvalidOperationException("시험 범위를 먼저 선택하세요.");
            }

            var result = await StudyCoachService.GenerateContentAsync(
                workspaceId,
                examRangeId,
                contentType,
                CancellationToken.None);

            _generatedContent = result.Content;
            _generatedProvider = result.Provider;
            _generatedModel = result.Model;
            _infoMessage = $"{(contentType == GeneratedContentType.Summary ? "요약" : "퀴즈")} 생성이 완료되었습니다.";
        });
    }

    private async Task CollectEducationMetadataAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var query = new EducationMetadataQueryModel(
                Subject: _metadataSubject,
                SchoolLevel: _metadataSchoolLevel,
                Grade: _metadataGrade,
                BirthYear: _metadataBirthYear,
                SchoolName: string.IsNullOrWhiteSpace(_metadataSchoolName) ? null : _metadataSchoolName.Trim());

            var result = await StudyCoachService.CollectEducationMetadataAsync(query, CancellationToken.None);

            _curriculumResults.Clear();
            _curriculumResults.AddRange(result.Curriculums);
            _textbookResults.Clear();
            _textbookResults.AddRange(result.Textbooks);
            _schoolFactResults.Clear();
            _schoolFactResults.AddRange(result.SchoolFacts);
            _sourceStatuses.Clear();
            _sourceStatuses.AddRange(result.SourceStatuses);
            _infoMessage = "교육과정/교과서 메타데이터 통합 조회가 완료되었습니다.";
        });
    }

    private async Task ReloadWorkspacesAsync()
    {
        _workspaces.Clear();
        _workspaces.AddRange(await StudyCoachService.GetWorkspacesAsync(CancellationToken.None));
    }

    private async Task RefreshCurrentWorkspaceAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            await ReloadWorkspacesAsync();
            await LoadWorkspaceDataAsync();
            _infoMessage = "데이터를 새로고침했습니다.";
        });
    }

    private async Task LoadWorkspaceDataAsync()
    {
        _examRanges.Clear();
        _documents.Clear();
        _jobs.Clear();

        if (!Guid.TryParse(_selectedWorkspaceId, out var workspaceId))
        {
            return;
        }

        _examRanges.AddRange(await StudyCoachService.GetExamRangesAsync(workspaceId, CancellationToken.None));
        _documents.AddRange(await StudyCoachService.GetDocumentsAsync(workspaceId, CancellationToken.None));
        _jobs.AddRange(await StudyCoachService.GetProcessingJobsAsync(workspaceId, CancellationToken.None));

        if (_examRanges.Count > 0 && !Guid.TryParse(_selectedExamRangeId, out _))
        {
            _selectedExamRangeId = _examRanges[0].Id.ToString();
        }
        else if (_examRanges.Count == 0)
        {
            _selectedExamRangeId = string.Empty;
        }
    }

    private Guid RequireWorkspaceSelection()
    {
        if (!Guid.TryParse(_selectedWorkspaceId, out var workspaceId))
        {
            throw new InvalidOperationException("먼저 Workspace를 선택하세요.");
        }

        return workspaceId;
    }

    private async Task RunWithErrorHandlingAsync(Func<Task> action)
    {
        _errorMessage = null;
        _infoMessage = null;

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
