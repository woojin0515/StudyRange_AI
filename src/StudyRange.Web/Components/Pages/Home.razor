@page "/"
@inject IStudyCoachService StudyCoachService
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<PageTitle>StudyRange AI</PageTitle>

<MudStack Spacing="3" Class="home-shell">
    <MudPaper Elevation="0" Outlined="true" Class="hero-panel">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="hero-top">
            <div>
                <MudText Typo="Typo.h4">StudyRange AI</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary">
                    워크스페이스부터 문서 처리, AI 생성, 교육 메타데이터 통합까지 한 화면에서 관리합니다.
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshCurrentWorkspaceAsync" Disabled="@_isBusy">
                새로고침
            </MudButton>
        </MudStack>

        <MudGrid Class="mt-3">
            <MudItem xs="6" md="3">
                <MudPaper Outlined="true" Class="summary-card">
                    <MudText Typo="Typo.caption">워크스페이스</MudText>
                    <MudText Typo="Typo.h6">@_workspaces.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Outlined="true" Class="summary-card">
                    <MudText Typo="Typo.caption">시험 범위</MudText>
                    <MudText Typo="Typo.h6">@_examRanges.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Outlined="true" Class="summary-card">
                    <MudText Typo="Typo.caption">문서</MudText>
                    <MudText Typo="Typo.h6">@_documents.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Outlined="true" Class="summary-card">
                    <MudText Typo="Typo.caption">생성 이력</MudText>
                    <MudText Typo="Typo.h6">@_generatedHistories.Count</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_infoMessage))
    {
        <MudAlert Severity="Severity.Info" Dense="true">@_infoMessage</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Outlined="true" Class="section-panel">
                <MudText Typo="Typo.h6">1) Workspace</MudText>
                <MudGrid Class="mt-2">
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_workspaceName"
                                      Label="Workspace 이름"
                                      HelperText="예: 중간고사, 기말고사, 6월 모의고사"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="align-end">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="CreateWorkspaceAsync"
                                   Disabled="@(_isBusy || string.IsNullOrWhiteSpace(_workspaceName))"
                                   FullWidth="true">
                            생성
                        </MudButton>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2">Workspace 선택</MudText>
                <MudStack Spacing="1" Class="mt-2 workspace-list">
                    @if (_workspaces.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="text-secondary">아직 생성된 Workspace가 없습니다.</MudText>
                    }
                    else
                    {
                        @foreach (var workspace in _workspaces)
                        {
                            <MudPaper Outlined="true" Class="pa-3 workspace-item">
                                <MudGrid>
                                    <MudItem xs="12" md="5">
                                        <MudText Typo="Typo.subtitle2">@workspace.Name</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudText Typo="Typo.caption">@workspace.CreatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudText>
                                    </MudItem>
                                    <MudItem xs="6" md="2">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="@(IsSelectedWorkspace(workspace.Id) ? Color.Success : Color.Primary)"
                                                   OnClick="@(() => SelectWorkspaceAsync(workspace.Id))"
                                                   Disabled="@_isBusy"
                                                   FullWidth="true">
                                            @(IsSelectedWorkspace(workspace.Id) ? "선택됨" : "선택")
                                        </MudButton>
                                    </MudItem>
                                    <MudItem xs="6" md="2">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteWorkspaceAsync(workspace.Id))"
                                                   Disabled="@_isBusy"
                                                   FullWidth="true">
                                            삭제
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudStack Spacing="2">
                <MudPaper Elevation="0" Outlined="true" Class="section-panel">
                    <MudText Typo="Typo.h6">2) 문서 업로드</MudText>
                    <MudGrid Class="mt-2">
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Class="text-secondary">문서 종류</MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-1">
                                <MudButton Variant="@(_selectedDocumentType == DocumentType.TextbookPdf ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           OnClick="@(() => _selectedDocumentType = DocumentType.TextbookPdf)">
                                    Textbook PDF
                                </MudButton>
                                <MudButton Variant="@(_selectedDocumentType == DocumentType.Worksheet ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           OnClick="@(() => _selectedDocumentType = DocumentType.Worksheet)">
                                    Worksheet
                                </MudButton>
                                <MudButton Variant="@(_selectedDocumentType == DocumentType.HandwrittenNotes ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           OnClick="@(() => _selectedDocumentType = DocumentType.HandwrittenNotes)">
                                    Handwritten Notes
                                </MudButton>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12">
                            <InputFile OnChange="OnFileSelected" class="file-input" accept="@UploadAccept" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UploadDocumentAsync" Disabled="@(_isBusy || !IsWorkspaceSelected)" FullWidth="true">
                                업로드
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    @if (!string.IsNullOrWhiteSpace(_selectedFileName))
                    {
                        <MudText Typo="Typo.caption" Class="mt-2">선택 파일: @_selectedFileName</MudText>
                    }
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="0" Outlined="true" Class="section-panel">
        <MudText Typo="Typo.h6">4) 교육과정/교과서 메타데이터 (NCIC + KOTRY + NEIS)</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="3">
                <MudSelect T="SchoolLevel" @bind-Value="MetadataSchoolLevel" Variant="Variant.Outlined" Label="학교급" FullWidth="true">
                    <MudSelectItem Value="@SchoolLevel.Elementary">초등</MudSelectItem>
                    <MudSelectItem Value="@SchoolLevel.Middle">중등</MudSelectItem>
                    <MudSelectItem Value="@SchoolLevel.High">고등</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="int"
                                 @bind-Value="_metadataGrade"
                                 Variant="Variant.Outlined"
                                 Label="학년"
                                 Min="1"
                                 Max="@GetMaxGradeBySchoolLevel(_metadataSchoolLevel)"
                                 FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="int?" @bind-Value="_metadataBirthYear" Variant="Variant.Outlined" Label="출생년도(선택)" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="_metadataSchoolName" Variant="Variant.Outlined" Label="학교명(선택)" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_metadataSubject" Variant="Variant.Outlined" Label="과목" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="2" Class="align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CollectEducationMetadataAsync" Disabled="@_isBusy" FullWidth="true">통합 조회</MudButton>
            </MudItem>
        </MudGrid>

        @if (_sourceStatuses.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2">소스 상태</MudText>
            <MudTable Items="_sourceStatuses" Dense="true" Hover="true" Class="mt-1">
                <HeaderContent>
                    <MudTh>소스</MudTh>
                    <MudTh>성공</MudTh>
                    <MudTh>메시지</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Source</MudTd>
                    <MudTd>@(context.Success ? "Yes" : "No")</MudTd>
                    <MudTd>@context.Message</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_curriculumResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3">교육과정</MudText>
            <MudTable Items="_curriculumResults" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>개정</MudTh>
                    <MudTh>표시명</MudTh>
                    <MudTh>설명</MudTh>
                    <MudTh>출처</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RevisionCode</MudTd>
                    <MudTd>@context.DisplayName</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>@context.Source</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_textbookResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3">교과서</MudText>
            <MudTable Items="_textbookResults" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>과목</MudTh>
                    <MudTh>출판사</MudTh>
                    <MudTh>교과서명</MudTh>
                    <MudTh>개정</MudTh>
                    <MudTh>출처</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Subject</MudTd>
                    <MudTd>@context.Publisher</MudTd>
                    <MudTd>@context.Title</MudTd>
                    <MudTd>@context.CurriculumRevision</MudTd>
                    <MudTd>@context.Source</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_schoolFactResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3">학교 맥락</MudText>
            <MudTable Items="_schoolFactResults" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>키</MudTh>
                    <MudTh>값</MudTh>
                    <MudTh>출처</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Key</MudTd>
                    <MudTd>@context.Value</MudTd>
                    <MudTd>@context.Source</MudTd>
                </RowTemplate>
            </MudTable>
        }

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2">확정 메타데이터 (수정 가능)</MudText>
        <MudGrid Class="mt-1">
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_resolvedCurriculumRevision" Variant="Variant.Outlined" Label="개정년도" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_resolvedTextbookPublisher" Variant="Variant.Outlined" Label="출판사" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_resolvedMetadataSubject" Variant="Variant.Outlined" Label="과목" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="2" Class="align-end">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ApplyRecommendedMetadataAsync" Disabled="@_isBusy" FullWidth="true">
                    조회결과 반영
                </MudButton>
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrWhiteSpace(_resolvedCurriculumRevision) || !string.IsNullOrWhiteSpace(_resolvedTextbookPublisher) || !string.IsNullOrWhiteSpace(_resolvedMetadataSubject))
        {
            <MudPaper Outlined="true" Class="pa-2 mt-2">
                <MudText Typo="Typo.caption">
                    반영값: 개정년도=@(_resolvedCurriculumRevision.Length == 0 ? "-" : _resolvedCurriculumRevision),
                    출판사=@(_resolvedTextbookPublisher.Length == 0 ? "-" : _resolvedTextbookPublisher),
                    과목=@(_resolvedMetadataSubject.Length == 0 ? "-" : _resolvedMetadataSubject)
                </MudText>
            </MudPaper>
        }
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="section-panel">
        <MudText Typo="Typo.h6">5) 시험범위 + AI 요약/퀴즈 생성</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.caption">과목</MudText>
                <MudText Typo="Typo.body2">@ExamRangeSubjectDisplay</MudText>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudNumericField T="int" @bind-Value="_startPage" Label="시작 페이지" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudNumericField T="int" @bind-Value="_endPage" Label="끝 페이지" Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="3" Class="align-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="AddExamRangeAsync"
                           Disabled="@(_isBusy || !IsWorkspaceSelected)"
                           FullWidth="true">
                    시험범위 등록
                </MudButton>
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-3" />
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.subtitle2">시험 범위 선택</MudText>
                <MudTable Items="_examRanges" Dense="true" Hover="true" Class="mt-1">
                    <HeaderContent>
                        <MudTh>과목</MudTh>
                        <MudTh>범위</MudTh>
                        <MudTh>동작</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Subject</MudTd>
                        <MudTd>@context.StartPage ~ @context.EndPage</MudTd>
                        <MudTd>
                            <MudButton Variant="@(IsSelectedExamRange(context.Id) ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => SelectExamRange(context.Id))">
                                @(IsSelectedExamRange(context.Id) ? "선택됨" : "선택")
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.caption">선택된 범위</MudText>
                    <MudText Typo="Typo.body2">@SelectedExamRangeDisplay</MudText>
                    <MudText Typo="Typo.caption" Class="mt-1">확정 출판사: @(string.IsNullOrWhiteSpace(_resolvedTextbookPublisher) ? "-" : _resolvedTextbookPublisher)</MudText>
                    <MudText Typo="Typo.caption">확정 과목: @(string.IsNullOrWhiteSpace(_resolvedMetadataSubject) ? "-" : _resolvedMetadataSubject)</MudText>
                    <MudDivider Class="my-2" />
                    @if (_isBusy && !string.IsNullOrWhiteSpace(_busyMessage))
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            @_busyMessage
                        </MudAlert>
                    }
                    @if (!CanGenerateContent)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@GenerationBlockedReason</MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateSummaryAsync" Disabled="@(_isBusy || !CanGenerateContent)" FullWidth="true">
                        요약 생성
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="GenerateQuizAsync" Disabled="@(_isBusy || !CanGenerateContent)" FullWidth="true" Class="mt-2">
                        퀴즈 생성
                    </MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrWhiteSpace(_generatedContent))
        {
            <MudDivider Class="my-3" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption">Provider: @_generatedProvider / Model: @_generatedModel</MudText>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Disabled="@_isBusy"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="@(() => CopyToClipboardAsync(_generatedContent))">
                    복사
                </MudButton>
            </MudStack>
            <MudPaper Outlined="true" Class="pa-3 mt-2 generated-content">
                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@_generatedContent</MudText>
            </MudPaper>
        }

        @if (_generatedHistories.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.subtitle2">생성 이력</MudText>
                <MudSelect T="string" @bind-Value="_historyFilter" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Style="min-width: 160px;">
                    <MudSelectItem Value="@("All")">전체</MudSelectItem>
                    <MudSelectItem Value="@("Summary")">요약</MudSelectItem>
                    <MudSelectItem Value="@("Quiz")">퀴즈</MudSelectItem>
                </MudSelect>
            </MudStack>
            <MudTable Items="FilteredGeneratedHistories" Dense="true" Hover="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>유형</MudTh>
                    <MudTh>범위</MudTh>
                    <MudTh>모델</MudTh>
                    <MudTh>생성시각</MudTh>
                    <MudTh>미리보기</MudTh>
                    <MudTh>동작</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ContentType</MudTd>
                    <MudTd>@($"{context.Subject} {context.StartPage}~{context.EndPage}")</MudTd>
                    <MudTd>@($"{context.Provider} / {context.Model}")</MudTd>
                    <MudTd>@context.GeneratedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                    <MudTd>
                        <MudTooltip Text="@context.Content">
                            <MudText Typo="Typo.caption" Class="job-error">확인</MudText>
                        </MudTooltip>
                    </MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       Disabled="@_isBusy"
                                       OnClick="@(() => ApplyGeneratedHistory(context.Id))">
                                불러오기
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Secondary"
                                       Disabled="@_isBusy"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="@(() => CopyToClipboardAsync(context.Content))">
                                복사
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="@_isBusy"
                                       OnClick="@(() => DeleteGeneratedHistoryAsync(context.Id))">
                                삭제
                            </MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudGrid>
        <MudItem xs="12">
            <MudPaper Elevation="0" Outlined="true" Class="section-panel">
                <MudText Typo="Typo.h6">문서 / 처리 작업</MudText>
                <MudTable Items="_documents" Dense="true" Hover="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>파일명</MudTh>
                        <MudTh>종류</MudTh>
                        <MudTh>상태</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.OriginalFileName</MudTd>
                        <MudTd>@context.DocumentType</MudTd>
                        <MudTd>@context.ProcessingStatus</MudTd>
                    </RowTemplate>
                </MudTable>

                <MudDivider Class="my-3" />

                <MudTable Items="_jobs" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Job</MudTh>
                        <MudTh>상태</MudTh>
                        <MudTh>완료시각</MudTh>
                        <MudTh>오류</MudTh>
                        <MudTh>동작</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Id.ToString()[..8]</MudTd>
                        <MudTd>@context.Status</MudTd>
                        <MudTd>@(context.CompletedAtUtc?.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</MudTd>
                        <MudTd>
                            @if (string.IsNullOrWhiteSpace(context.ErrorMessage))
                            {
                                <MudText Typo="Typo.caption" Class="text-secondary">-</MudText>
                            }
                            else
                            {
                                <MudTooltip Text="@context.ErrorMessage">
                                    <MudText Typo="Typo.caption" Class="job-error">확인</MudText>
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.Status == ProcessingStatus.Failed)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           Disabled="@_isBusy"
                                           OnClick="@(() => RetryJobAsync(context.Id))">
                                    재처리
                                </MudButton>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="text-secondary">-</MudText>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private readonly List<WorkspaceModel> _workspaces = [];
    private readonly List<ExamRangeModel> _examRanges = [];
    private readonly List<DocumentModel> _documents = [];
    private readonly List<ProcessingJobModel> _jobs = [];
    private readonly List<GeneratedContentHistoryModel> _generatedHistories = [];
    private string _historyFilter = "All";

    private string _workspaceName = string.Empty;
    private string _selectedWorkspaceId = string.Empty;
    private string _selectedExamRangeId = string.Empty;
    private int _startPage = 1;
    private int _endPage = 1;
    private DocumentType _selectedDocumentType = DocumentType.TextbookPdf;
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;

    private string? _infoMessage;
    private string? _errorMessage;
    private string? _busyMessage;
    private bool _isBusy;
    private string _generatedContent = string.Empty;
    private string _generatedProvider = string.Empty;
    private string _generatedModel = string.Empty;
    private SchoolLevel _metadataSchoolLevel = SchoolLevel.Middle;
    private int _metadataGrade = 1;
    private int? _metadataBirthYear;
    private string _metadataSchoolName = string.Empty;
    private string _metadataSubject = string.Empty;
    private readonly List<CurriculumRevisionModel> _curriculumResults = [];
    private readonly List<TextbookCatalogModel> _textbookResults = [];
    private readonly List<SchoolContextFactModel> _schoolFactResults = [];
    private readonly List<SourceStatusModel> _sourceStatuses = [];
    private string _resolvedCurriculumRevision = string.Empty;
    private string _resolvedTextbookPublisher = string.Empty;
    private string _resolvedMetadataSubject = string.Empty;
    private readonly SemaphoreSlim _workspaceReloadLock = new(1, 1);
    private CancellationTokenSource? _autoRefreshCts;
    private Task? _autoRefreshTask;
    private bool IsWorkspaceSelected => Guid.TryParse(_selectedWorkspaceId, out _);
    private bool CanGenerateContent =>
        IsWorkspaceSelected &&
        Guid.TryParse(_selectedExamRangeId, out _) &&
        !string.IsNullOrWhiteSpace(_resolvedTextbookPublisher);
    private string GenerationBlockedReason =>
        !IsWorkspaceSelected ? "먼저 Workspace를 선택하세요."
        : !Guid.TryParse(_selectedExamRangeId, out _) ? "시험 범위를 먼저 선택하세요."
        : string.IsNullOrWhiteSpace(_resolvedTextbookPublisher) ? "먼저 메타데이터 조회 후 출판사를 확정하세요."
        : string.Empty;
    private string ExamRangeSubjectDisplay =>
        string.IsNullOrWhiteSpace(_resolvedMetadataSubject)
            ? "(메타데이터 과목 확정 필요)"
            : _resolvedMetadataSubject;
    private IEnumerable<GeneratedContentHistoryModel> FilteredGeneratedHistories => _historyFilter switch
    {
        "Summary" => _generatedHistories.Where(x => x.ContentType == GeneratedContentType.Summary),
        "Quiz" => _generatedHistories.Where(x => x.ContentType == GeneratedContentType.Quiz),
        _ => _generatedHistories
    };
    private string UploadAccept => _selectedDocumentType switch
    {
        DocumentType.TextbookPdf => ".pdf,application/pdf",
        DocumentType.Worksheet or DocumentType.HandwrittenNotes => ".pdf,.png,.jpg,.jpeg,.webp,application/pdf,image/png,image/jpeg,image/webp",
        _ => ".pdf"
    };

    protected override async Task OnInitializedAsync()
    {
        await ReloadWorkspacesAsync();
        if (_workspaces.Count > 0)
        {
            _selectedWorkspaceId = _workspaces[0].Id.ToString();
            await LoadWorkspaceDataAsync();
        }

        _autoRefreshCts = new CancellationTokenSource();
        _autoRefreshTask = RunAutoRefreshAsync(_autoRefreshCts.Token);
    }

    private async Task CreateWorkspaceAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var created = await StudyCoachService.CreateWorkspaceAsync(_workspaceName, CancellationToken.None);
            _workspaceName = string.Empty;
            _selectedWorkspaceId = created.Id.ToString();
            await ReloadWorkspacesAsync();
            await LoadWorkspaceDataAsync();
            _infoMessage = "Workspace가 생성되었습니다.";
        });
    }

    private async Task SelectWorkspaceAsync(Guid workspaceId)
    {
        _selectedWorkspaceId = workspaceId.ToString();
        _generatedContent = string.Empty;
        _generatedProvider = string.Empty;
        _generatedModel = string.Empty;
        await LoadWorkspaceDataAsync();
    }

    private async Task DeleteWorkspaceAsync(Guid workspaceId)
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            await StudyCoachService.DeleteWorkspaceAsync(workspaceId, CancellationToken.None);
            if (Guid.TryParse(_selectedWorkspaceId, out var selectedWorkspaceId) && selectedWorkspaceId == workspaceId)
            {
                _selectedWorkspaceId = string.Empty;
                _selectedExamRangeId = string.Empty;
                _generatedContent = string.Empty;
                _generatedProvider = string.Empty;
                _generatedModel = string.Empty;
            }

            await ReloadWorkspacesAsync();
            if (_workspaces.Count > 0 && !Guid.TryParse(_selectedWorkspaceId, out _))
            {
                _selectedWorkspaceId = _workspaces[0].Id.ToString();
                await LoadWorkspaceDataAsync();
            }
            else if (_workspaces.Count == 0)
            {
                _examRanges.Clear();
                _documents.Clear();
                _jobs.Clear();
                _generatedHistories.Clear();
            }

            _infoMessage = "Workspace를 삭제했습니다.";
        });
    }

    private bool IsSelectedWorkspace(Guid workspaceId)
    {
        return Guid.TryParse(_selectedWorkspaceId, out var selectedId) && selectedId == workspaceId;
    }

    private async Task AddExamRangeAsync()
    {
        await RunWithErrorHandlingAsync("시험 범위 등록 중...", async () =>
        {
            var workspaceId = RequireWorkspaceSelection();
            var subject = ResolveExamRangeSubject();
            var startPage = _startPage;
            var endPage = _endPage;
            await StudyCoachService.AddExamRangeAsync(
                workspaceId,
                subject,
                startPage,
                endPage,
                CancellationToken.None);

            await LoadWorkspaceDataAsync();
            var createdRange = _examRanges
                .OrderByDescending(x => x.CreatedAtUtc)
                .FirstOrDefault(x => x.Subject == subject && x.StartPage == startPage && x.EndPage == endPage);
            if (createdRange is not null)
            {
                _selectedExamRangeId = createdRange.Id.ToString();
            }

            _infoMessage = "시험 범위가 등록되었습니다.";
        });
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _selectedFileName = args.File.Name;
    }

    private async Task UploadDocumentAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var workspaceId = RequireWorkspaceSelection();

            if (_selectedFile is null)
            {
                throw new InvalidOperationException("업로드할 파일을 선택하세요.");
            }

            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            await StudyCoachService.UploadDocumentAsync(
                workspaceId,
                _selectedDocumentType,
                _selectedFile.Name,
                _selectedFile.ContentType,
                _selectedFile.Size,
                stream,
                CancellationToken.None);

            _selectedFile = null;
            _selectedFileName = null;
            await LoadWorkspaceDataAsync();
            _infoMessage = "문서 업로드 후 처리 큐에 등록되었습니다.";
        });
    }

    private async Task GenerateSummaryAsync()
    {
        await GenerateContentAsync(GeneratedContentType.Summary);
    }

    private async Task GenerateQuizAsync()
    {
        await GenerateContentAsync(GeneratedContentType.Quiz);
    }

    private async Task GenerateContentAsync(GeneratedContentType contentType)
    {
        var busyMessage = contentType == GeneratedContentType.Summary
            ? "요약 생성 중..."
            : "퀴즈 생성 중...";
        await RunWithErrorHandlingAsync(busyMessage, async () =>
        {
            if (string.IsNullOrWhiteSpace(_resolvedTextbookPublisher))
            {
                throw new InvalidOperationException("먼저 메타데이터를 조회하고 출판사를 확정하세요.");
            }

            var workspaceId = RequireWorkspaceSelection();
            if (!Guid.TryParse(_selectedExamRangeId, out var examRangeId))
            {
                throw new InvalidOperationException("시험 범위를 먼저 선택하세요.");
            }

            var result = await StudyCoachService.GenerateContentAsync(
                workspaceId,
                examRangeId,
                contentType,
                CancellationToken.None);

            _generatedContent = result.Content;
            _generatedProvider = result.Provider;
            _generatedModel = result.Model;
            await LoadWorkspaceDataAsync();
            _infoMessage = $"{(contentType == GeneratedContentType.Summary ? "요약" : "퀴즈")} 생성이 완료되었습니다.";
        });
    }

    private async Task CollectEducationMetadataAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var subject = ResolveMetadataSubject();
            _metadataSubject = subject;
            _metadataGrade = Math.Clamp(_metadataGrade, 1, GetMaxGradeBySchoolLevel(_metadataSchoolLevel));
            var query = new EducationMetadataQueryModel(
                Subject: subject,
                SchoolLevel: _metadataSchoolLevel,
                Grade: _metadataGrade,
                BirthYear: _metadataBirthYear,
                SchoolName: string.IsNullOrWhiteSpace(_metadataSchoolName) ? null : _metadataSchoolName.Trim());

            var result = await StudyCoachService.CollectEducationMetadataAsync(query, CancellationToken.None);

            _curriculumResults.Clear();
            _curriculumResults.AddRange(result.Curriculums);
            _textbookResults.Clear();
            _textbookResults.AddRange(result.Textbooks);
            _schoolFactResults.Clear();
            _schoolFactResults.AddRange(result.SchoolFacts);
            _sourceStatuses.Clear();
            _sourceStatuses.AddRange(result.SourceStatuses);
            ApplyRecommendedMetadataFromResults();
            _infoMessage = "교육과정/교과서 메타데이터 통합 조회가 완료되었습니다.";
        });
    }

    private async Task ApplyRecommendedMetadataAsync()
    {
        await RunWithErrorHandlingAsync(() =>
        {
            if (_curriculumResults.Count == 0 && _textbookResults.Count == 0)
            {
                throw new InvalidOperationException("반영할 조회 결과가 없습니다. 먼저 통합 조회를 실행하세요.");
            }

            ApplyRecommendedMetadataFromResults();
            _infoMessage = "조회 결과를 확정 메타데이터에 반영했습니다. 필요하면 직접 수정하세요.";
            return Task.CompletedTask;
        });
    }

    private static int GetMaxGradeBySchoolLevel(SchoolLevel schoolLevel)
    {
        return schoolLevel switch
        {
            SchoolLevel.Elementary => 6,
            SchoolLevel.Middle or SchoolLevel.High => 3,
            _ => 3
        };
    }

    private SchoolLevel MetadataSchoolLevel
    {
        get => _metadataSchoolLevel;
        set
        {
            _metadataSchoolLevel = value;
            _metadataGrade = Math.Clamp(_metadataGrade, 1, GetMaxGradeBySchoolLevel(_metadataSchoolLevel));
        }
    }

    private bool HasActiveProcessingJobs =>
        _jobs.Any(x => x.Status is ProcessingStatus.Queued or ProcessingStatus.Processing);

    private string ResolveMetadataSubject()
    {
        if (!string.IsNullOrWhiteSpace(_metadataSubject))
        {
            return _metadataSubject.Trim();
        }

        var selectedExamRangeSubject = _examRanges
            .FirstOrDefault(x => x.Id.ToString() == _selectedExamRangeId)?
            .Subject;
        if (!string.IsNullOrWhiteSpace(selectedExamRangeSubject))
        {
            return selectedExamRangeSubject;
        }

        var firstSubject = _examRanges.FirstOrDefault()?.Subject;
        return firstSubject?.Trim() ?? string.Empty;
    }

    private string ResolveExamRangeSubject()
    {
        if (!string.IsNullOrWhiteSpace(_resolvedMetadataSubject))
        {
            return _resolvedMetadataSubject.Trim();
        }

        if (!string.IsNullOrWhiteSpace(_metadataSubject))
        {
            return _metadataSubject.Trim();
        }

        throw new InvalidOperationException("시험 범위 과목이 없습니다. 먼저 메타데이터에서 과목을 확정하세요.");
    }

    private void ApplyRecommendedMetadataFromResults()
    {
        _resolvedCurriculumRevision = _curriculumResults.FirstOrDefault()?.RevisionCode ?? string.Empty;
        _resolvedTextbookPublisher = _textbookResults.FirstOrDefault()?.Publisher ?? string.Empty;
        _resolvedMetadataSubject = _textbookResults.FirstOrDefault()?.Subject ?? ResolveMetadataSubject();
    }

    private bool IsSelectedExamRange(Guid examRangeId)
    {
        return Guid.TryParse(_selectedExamRangeId, out var selectedExamRangeId) && selectedExamRangeId == examRangeId;
    }

    private void SelectExamRange(Guid examRangeId)
    {
        _selectedExamRangeId = examRangeId.ToString();
    }

    private string SelectedExamRangeDisplay
    {
        get
        {
            if (!Guid.TryParse(_selectedExamRangeId, out var examRangeId))
            {
                return "선택된 시험 범위 없음";
            }

            var selected = _examRanges.FirstOrDefault(x => x.Id == examRangeId);
            return selected is null
                ? "선택된 시험 범위 없음"
                : $"{selected.Subject} {selected.StartPage}~{selected.EndPage}";
        }
    }

    private async Task ReloadWorkspacesAsync()
    {
        _workspaces.Clear();
        _workspaces.AddRange(await StudyCoachService.GetWorkspacesAsync(CancellationToken.None));
    }

    private async Task RefreshCurrentWorkspaceAsync()
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            await ReloadWorkspacesAsync();
            await LoadWorkspaceDataAsync();
            _infoMessage = "데이터를 새로고침했습니다.";
        });
    }

    private async Task RetryJobAsync(Guid jobId)
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var workspaceId = RequireWorkspaceSelection();
            await StudyCoachService.RetryProcessingJobAsync(workspaceId, jobId, CancellationToken.None);
            await LoadWorkspaceDataAsync();
            _infoMessage = "실패 작업을 재처리 큐에 등록했습니다.";
        });
    }

    private Task ApplyGeneratedHistory(Guid historyId)
    {
        var selected = _generatedHistories.FirstOrDefault(x => x.Id == historyId);
        if (selected is null)
        {
            _errorMessage = "선택한 생성 이력을 찾을 수 없습니다.";
            return Task.CompletedTask;
        }

        _generatedContent = selected.Content;
        _generatedProvider = selected.Provider;
        _generatedModel = selected.Model;
        _selectedExamRangeId = selected.ExamRangeId.ToString();
        _infoMessage = "생성 이력을 화면에 불러왔습니다.";
        _errorMessage = null;
        return Task.CompletedTask;
    }

    private async Task DeleteGeneratedHistoryAsync(Guid historyId)
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            var workspaceId = RequireWorkspaceSelection();
            await StudyCoachService.DeleteGeneratedContentAsync(workspaceId, historyId, CancellationToken.None);
            await LoadWorkspaceDataAsync();
            _infoMessage = "생성 이력을 삭제했습니다.";
        });
    }

    private async Task CopyToClipboardAsync(string text)
    {
        await RunWithErrorHandlingAsync(async () =>
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _infoMessage = "클립보드에 복사했습니다.";
        });
    }

    private async Task LoadWorkspaceDataAsync()
    {
        await _workspaceReloadLock.WaitAsync();
        try
        {
        _examRanges.Clear();
        _documents.Clear();
        _jobs.Clear();
        _generatedHistories.Clear();

        if (!Guid.TryParse(_selectedWorkspaceId, out var workspaceId))
        {
            return;
        }

        _examRanges.AddRange(await StudyCoachService.GetExamRangesAsync(workspaceId, CancellationToken.None));
        _documents.AddRange(await StudyCoachService.GetDocumentsAsync(workspaceId, CancellationToken.None));
        _jobs.AddRange(await StudyCoachService.GetProcessingJobsAsync(workspaceId, CancellationToken.None));
        _generatedHistories.AddRange(await StudyCoachService.GetGeneratedContentsAsync(workspaceId, CancellationToken.None));

        if (_examRanges.Count > 0 && !Guid.TryParse(_selectedExamRangeId, out _))
        {
            _selectedExamRangeId = _examRanges[0].Id.ToString();
        }
        else if (_examRanges.Count == 0)
        {
            _selectedExamRangeId = string.Empty;
        }
        }
        finally
        {
            _workspaceReloadLock.Release();
        }
    }

    private async Task RunAutoRefreshAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    if (IsWorkspaceSelected && HasActiveProcessingJobs)
                    {
                        await LoadWorkspaceDataAsync();
                        StateHasChanged();
                    }
                });
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
            }
        }
    }

    private Guid RequireWorkspaceSelection()
    {
        if (!Guid.TryParse(_selectedWorkspaceId, out var workspaceId))
        {
            throw new InvalidOperationException("먼저 Workspace를 선택하세요.");
        }

        return workspaceId;
    }

    private Task RunWithErrorHandlingAsync(Func<Task> action)
    {
        return RunWithErrorHandlingAsync(null, action);
    }

    private async Task RunWithErrorHandlingAsync(string? busyMessage, Func<Task> action)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _busyMessage = busyMessage;
        _errorMessage = null;
        _infoMessage = null;

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busyMessage = null;
            _isBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_autoRefreshCts is not null)
        {
            await _autoRefreshCts.CancelAsync();
            _autoRefreshCts.Dispose();
        }

        if (_autoRefreshTask is not null)
        {
            try
            {
                await _autoRefreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _workspaceReloadLock.Dispose();
    }
}
