@page "/profile"
@inject UserSessionState Session
@inject NavigationManager Navigation

<PageTitle>프로필 - StudyRange AI</PageTitle>

@if (!Session.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        로그인 후 이용할 수 있습니다.
    </MudAlert>
}
else
{
    <MudStack Spacing="3" Class="profile-shell">
        <MudText Typo="Typo.h5">프로필</MudText>
        <MudPaper Outlined="true" Class="pa-4 profile-panel">
            <MudTextField @bind-Value="_displayName" Label="표시 이름" Variant="Variant.Outlined" FullWidth="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3 profile-save" OnClick="SaveProfile">
                저장
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">@_message</MudAlert>
            }
        </MudPaper>
    </MudStack>
}

@code {
    private string _displayName = string.Empty;
    private string? _message;

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login?returnUrl=/profile", forceLoad: false);
            return;
        }

        _displayName = Session.DisplayName;
    }

    private void SaveProfile()
    {
        Session.UpdateDisplayName(_displayName);
        _message = "프로필이 저장되었습니다.";
    }
}
